DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_kernel?schema=public"
JWT_ACCESS_SECRET="change_me_to_a_long_random_string"
JWT_REFRESH_SECRET="change_me_to_another_long_random_string"
PORT=4000
# مطلوب لتفعيل "Continue with Google" - احصلي على Client ID حقيقي من
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID،
# نوع "Web application"). من غيره الـ endpoint هيرفض بصراحة بدل ما يتظاهر إنه شغال
GOOGLE_CLIENT_ID=""
# دومينات الفرونت إند الحقيقية المسموح ليها تتواصل مع الباك اند -
# افصلي كذا دومين بفاصلة لو عندك أكتر من واحد (زي دومين تجريبي وحقيقي)
ALLOWED_ORIGINS="https://digital.blue-field.co"

# عنوان الباك إند العام (نفس رابط Railway). Google Wallet بيجيب منه لوجو
# الشركة، ومحتاج رابط حقيقي على النت - لو سبتيه فاضي بنستنتجه من الطلب
PUBLIC_API_BASE_URL=""
# رابط الفرونت إند (بيتبني عليه رابط الرجوع بعد الدفع على MyFatoorah)
FRONTEND_BASE_URL="https://digital.blue-field.co"

# --- Google Wallet (اختياري - من غيره الكارت بيشتغل بـ QR بس) ---
# 1) Issuer ID: من Google Pay & Wallet Console (pay.google.com/business/console)
GOOGLE_WALLET_ISSUER_ID=""
# 2) محتوى ملف الـ JSON الخاص بالـ Service Account كامل (في سطر واحد)
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
